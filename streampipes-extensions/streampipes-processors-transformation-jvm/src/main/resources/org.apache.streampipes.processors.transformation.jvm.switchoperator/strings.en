org.apache.streampipes.processors.transformation.jvm.switchoperator.title=Switch Operator
org.apache.streampipes.processors.transformation.jvm.switchoperator.description=Logical Switch operator implemented for streampipes

switch-filter-key.title=Input Field
switch-filter-key.description=The field from the event to evaluate in the switch statement. Can be of any data type, converted to a string for comparison.

switch-case-group.title=Switch Cases
switch-case-group.description=Switch case-value pairs for outputting a value based on the matched case.

switch-case-value.title=Case Value
switch-case-value.description=The string value to compare against the input field.

switch-case-value-output.title=Output Value
switch-case-value-output.description=The value to return when the case matches, matching the selected output type (e.g., true/false for Boolean, any string for String, a number for Integer).

switch-filter-result.title=Result
switch-filter-result.description=The result of the switch operation, in the user-selected data type (String, Boolean, or Integer).

switch-case-value-default-output.title=Default Output Value
switch-case-value-default-output.description=The value to return when no case matches, matching the selected output type (e.g., empty string for String, false for Boolean, 0 for Integer).

output-type.title=Output Type
output-type.description=The data type of the output result (String, Boolean, or Integer).