org.apache.streampipes.processors.transformation.jvm.switchoperator.title=Switch Operator
org.apache.streampipes.processors.transformation.jvm.switchoperator.description=Logical Switch operator implemented for streampipes

switch-filter-key.title=Input Field
switch-filter-key.description=The field from the event to evaluate in the switch statement

switch-case-group.title=Switch Cases
switch-case-group.description=Switch case-value pairs for outputting event on matched case

switch-case-value.title=Case Value
switch-case-value.description=The value to compare against the input field

switch-case-value-output.title=Output Value
switch-case-value-output.description=The boolean result to return when the case matches (true/false)

switch-filter-result.title=Result
switch-filter-result.description=The boolean result of the switch operation

switch-case-value-default-output.title=Default Output Value
switch-case-value-default-output.description=The boolean result to return when no case matches (true/false)
