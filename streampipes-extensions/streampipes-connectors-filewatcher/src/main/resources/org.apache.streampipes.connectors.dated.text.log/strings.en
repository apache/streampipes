org.apache.streampipes.connectors.dated.text.log.title=Dated Text Log
org.apache.streampipes.connectors.dated.text.log.description=Reads dated log files and maps line fields to events.
directory.title=Log directory
directory.description=Directory containing the daily files for one event stream.
filename-pattern.title=Filename expression
filename-pattern.description=Java regex matching the whole filename, with one capture group for its date.
date-format.title=Filename date format
date-format.description=Java date format for the captured date, for example uuuu_MM_dd.
line-pattern.title=Line expression
line-pattern.description=Java regex matching one complete line, with one capture group per output field.
fields.title=Output fields
fields.description=Comma-separated name:type entries in capture order. Use one time field and string, integer, long or double for other fields.
time-format.title=Time format
time-format.description=Java time format for the time capture group.
charset.title=File encoding
charset.description=Character set used by the log writer, for example UTF-16LE or UTF-8.
timezone.title=Machine timezone
timezone.description=IANA timezone of the local date and time, for example Europe/Berlin.
poll-interval-seconds.title=Polling interval (seconds)
poll-interval-seconds.description=Seconds between directory scans.
