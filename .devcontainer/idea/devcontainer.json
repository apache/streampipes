{
  "name": "Apache StreamPipes Dev (IDEA)",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/streampipes",
  "runServices": [
    "workspace",
    "couchdb",
    "influxdb",
    "nats"
  ],
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "customizations": {
    "jetbrains": {
      "backend": "IntelliJ"
    }
  },
  "forwardPorts": [
    8030,
    8090,
    8082,
    5984,
    8086,
    4222,
    8222
  ],
  "portsAttributes": {
    "8030": {
      "label": "StreamPipes Core"
    },
    "8090": {
      "label": "StreamPipes IIoT Extensions"
    },
    "8082": {
      "label": "StreamPipes UI"
    },
    "5984": {
      "label": "CouchDB"
    },
    "8086": {
      "label": "InfluxDB"
    },
    "4222": {
      "label": "NATS"
    },
    "8222": {
      "label": "NATS Monitoring"
    }
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.m2 /home/vscode/.npm /home/vscode/.streampipes /workspaces/streampipes/ui/node_modules && mvn -version && node --version && npm --version"
}
