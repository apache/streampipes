# Copy this file to .devcontainer/.env to customize one checkout.
#
# For a second checkout or PR worktree, use a different project name and ports.
# Compose will then create separate containers, volumes and networks.

COMPOSE_PROJECT_NAME=streampipes-dev

SP_CORE_PORT=8030
SP_EXTENSIONS_IIOT_PORT=8090
SP_UI_PORT=8082

SP_COUCHDB_PORT=5984
SP_TS_STORAGE_PORT=8086
SP_NATS_PORT=4222
SP_NATS_MONITORING_PORT=8222

SP_CORE_DEBUG_PORT=5005
SP_EXTENSIONS_IIOT_DEBUG_PORT=5006

SP_INFLUX_INIT_MODE=setup
