SP_VERSION=0.99.0-SNAPSHOT
SP_DOCKER_REGISTRY=apachestreampipes
COMPOSE_PROJECT_NAME=streampipes

# For database migration in v0.91.0 - set init mode to 'upgrade' to migrate an existing installation
SP_INFLUX_INIT_MODE=setup
#SP_INFLUX_INIT_MODE=upgrade

# NATS token generated by configure, used by docker-compose.nats-auth.yml and
# docker-compose.minimal.nats-auth.yml
SP_NATS_TOKEN=

# Run ./configure for a new installation. It generates these settings in .env:
# SP_SERVICE_SECRET
# SP_COUCHDB_PASSWORD
# SP_TS_STORAGE_TOKEN
# SP_INFLUXDB_ADMIN_PASSWORD
# SP_ENCRYPTION_PASSCODE
# SP_INITIAL_ADMIN_PASSWORD
# SP_NATS_TOKEN
# SP_JWT_SECRET
# Existing credentials in .env are preserved on subsequent runs.
# Never generate a new encryption passcode for existing encrypted data.
